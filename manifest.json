{
    "manifest_version": 3,
    "name": "Movie Vocab Builder",
    "version": "0.1",
    "description": "Captures subtitles while you watch and builds a vocabulary list.",
    "host_permissions": [
      "*://*.netflix.com/*",
      "https://scenevocab.onrender.com/*",
      "http://localhost:5000/*"

    ],
    "content_scripts": [
      {
        "matches": ["*://*.netflix.com/*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
  }